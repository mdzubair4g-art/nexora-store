# Copy this file to .env for local development and replace the placeholders.
# Never commit .env or paste production secrets into source control.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# Keep false while seeded products are demonstration content.
# Set true only after verifying real products, prices, stock, promotions and fulfilment.
CATALOGUE_LIVE=false
