{
  "name": "nexora-in",
  "version": "2.0.0",
  "description": "NEXORA.in — Modern Full-Stack E-Commerce Marketplace (React 18 + Node.js + SQLite)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "seed": "node server/seed.js",
    "build": "cd client && npm install && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "keywords": [
    "ecommerce",
    "react",
    "express",
    "sqlite",
    "marketplace"
  ],
